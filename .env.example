# ── API Keys ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...          # default provider (LLM_PROVIDER=openai)
BRAVE_API_KEY=...                   # optional: better web search than DuckDuckGo

# ── LLM provider + models ─────────────────────────────────────────────────────
# LLM_PROVIDER=openai               # openai (default) | anthropic | bedrock
# Balanced quality/cost tier mapping (all optional — these are the defaults):
#   quality (live research + outreach)        -> gpt-4.1
#   fast    (discovery, live contact + score) -> gpt-4.1-mini
#   batch   (batch contact/score/outreach)    -> gpt-4o-mini
#   batch research round                      -> gpt-4.1 (OPENAI_BATCH_QUALITY_MODEL)
OPENAI_QUALITY_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_BATCH_MODEL=gpt-4o-mini
OPENAI_BATCH_QUALITY_MODEL=gpt-4.1
# ANALYSIS_PATH=live                # live (default) | batch — run_pipeline default analysis path

# ── Database ──────────────────────────────────────────────────────────────────
# Local: leave unset (defaults to data/pipeline.db)
# Railway: set to /data/pipeline.db (persistent volume mounted at /data)
# DB_PATH=/data/pipeline.db

# ── Email Report (Gmail) ──────────────────────────────────────────────────────
# 1. Enable 2FA on your Gmail account
# 2. Go to myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail"
# 4. Paste the 16-character password (no spaces) as SMTP_PASS
EMAIL_TO=dailyasia9@gmail.com
EMAIL_FROM=your-sender@gmail.com
SMTP_USER=your-sender@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
